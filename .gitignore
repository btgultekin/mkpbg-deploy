# ASP.NET — never commit configuration (secrets, passwords, connection strings)
appsettings.json
appsettings.*.json
**/secrets.json

# User secrets / env
.env
.env.*

# Logs — keep the folder so ANCM can write stdout/ancm files
*.log
logs/*
!logs/.gitkeep

# Uploaded branding (survives git pull if the folder stays writable)
uploads/branding/*
!uploads/branding/.gitkeep
App_Data/

# OS
Thumbs.db
Desktop.ini
.DS_Store
